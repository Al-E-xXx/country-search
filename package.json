{
  "name": "country-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live country search app (RS School fullstack engineering task)",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "serve dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
